@model List<DbRow>
@{ViewData["Title"]="Sucursales";}
<section class="content-head"><span class="eyebrow">UBICACIONES</span><h1>Sucursales</h1><p>Gestiona direcciones, teléfonos y estatus de tus sucursales.</p>
<a asp-controller="Gestion" asp-action="SucursalNueva" class="btn btn-primary">+ Crear sucursal</a></section>
<div class="table-panel"><div class="table-panel-top"><strong>@Model.Count sucursales</strong><span>Ubicaciones de tu empresa</span></div>
<div class="table-overflow"><table class="data-table"><thead><tr><th>Sucursal</th><th>Teléfono</th><th>Calle y número</th><th>Entre calles</th><th>Colonia</th><th>Estatus</th><th>Acciones</th></tr></thead><tbody>
@foreach(var s in Model){<tr><td><strong>@s.S("nombre")</strong></td><td>@s.S("telefono")</td>
<td>@s.S("calle") @s.S("numero_exterior")</td><td>@s.S("entre_calle_1") @(!string.IsNullOrWhiteSpace(s.S("entre_calle_2"))?"y "+s.S("entre_calle_2"):"")</td><td>@s.S("colonia")</td>
<td><span class="state-pill">@(s.S("estatus")=="sucursal_activa"?"Activa":"Inactiva")</span></td>
<td><div class="empresa-table-actions"><a class="btn btn-outline btn-sm" asp-action="EditarSucursal" asp-route-id="@s.I("id_sucursal")">Editar</a>
@if(s.S("estatus")=="sucursal_activa"){
<form method="post" asp-action="DesactivarSucursal" onsubmit="return confirm('¿Desactivar esta sucursal? Sus citas se conservarán.')"><input type="hidden" name="id" value="@s.I("id_sucursal")"/><button type="submit" class="btn btn-outline btn-sm">Eliminar</button></form>
}</div></td></tr>}
</tbody></table></div>
@if(Model.Count==0){<div class="empty-mini">Todavía no hay sucursales. Registra la primera para comenzar.</div>}
</div>
