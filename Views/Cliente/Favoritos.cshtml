@model List<DbRow>
@{ViewData["Title"]="Mis favoritos";}
<section class="content-head"><span class="eyebrow">TUS PREFERIDOS</span><h1>Mis servicios favoritos</h1><p>Guarda y consulta los servicios que te interesan.</p></section>
<div class="favorites-list">@foreach(var f in Model){<article class="favorite-card"><div class="fav-icon favorite-service-photo"><img src="/Imagenes/Ver?uso=imagen_servicio&amp;id=@f.I("id_servicio")" alt="" loading="lazy" onerror="this.style.display='none'" /></div><div><h3>@f.S("nombre")</h3><p>@f.S("descripcion")</p></div><form method="post" asp-action="Favorito"><input type="hidden" name="servicioId" value="@f.I("id_servicio")" /><input type="hidden" name="agregar" value="false" /><button type="submit" class="btn btn-outline btn-sm">Quitar</button></form></article>}</div>
@if(Model.Count==0){<div class="empty-state"><h2>Aún no guardas favoritos</h2><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Descubrir servicios</a></div>}
