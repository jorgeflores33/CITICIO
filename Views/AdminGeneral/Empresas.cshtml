@model List<DbRow>
@{
 ViewData["Title"] = "Empresas · Administración CITICIO";
 var buscar = (string?)ViewBag.Buscar ?? "";
}
<section class="content-head"><span class="eyebrow">ADMINISTRADOR GENERAL</span><h1>Empresas</h1><p>Consulta los negocios registrados. La activación es automática; puedes suspender o reactivar una empresa con permisos de administrador general.</p></section>
<div class="ag-toolbar"><form method="get" asp-controller="AdminGeneral" asp-action="Empresas" class="ag-search"><label for="buscaEmpresa">Buscar empresas</label><div><input id="buscaEmpresa" name="buscar" maxlength="120" value="@buscar" placeholder="Nombre comercial" /><button type="submit" class="btn btn-primary">Buscar</button></div></form><a class="btn btn-outline" asp-controller="Gestion" asp-action="EmpresaNueva">+ Nueva empresa</a></div>
<div class="table-panel"><div class="table-panel-top"><strong>@Model.Count empresas</strong><span>Hasta 200 resultados por consulta</span></div>
<div class="table-overflow"><table class="data-table ag-table"><thead><tr><th>ID</th><th>Empresa</th><th>Estado</th><th>Acción administrativa</th></tr></thead><tbody>
@foreach (var e in Model) {
 var activa = e.S("nombre_estado") == "empresa_activa";
 <tr><td>#@e.I("id_empresa")</td><td><strong>@e.S("nombre")</strong><div class="ag-tiny">@e.S("descripcion")</div></td><td><span class="ag-status @(activa?"ag-on":"ag-off")">@(activa?"Activa":"Inactiva")</span></td><td>
 <form asp-controller="AdminGeneral" asp-action="CambiarEstado" method="post" class="ag-action-form">
  @Html.AntiForgeryToken()
  <input type="hidden" name="idEmpresa" value="@e.I("id_empresa")" />
  <input type="hidden" name="nuevoEstado" value="@(activa?"empresa_inactiva":"empresa_activa")" />
  @if(activa){<label for="motivo_@e.I("id_empresa")">Motivo para suspender</label><input required minlength="10" maxlength="500" id="motivo_@e.I("id_empresa")" name="motivo" placeholder="Explica por qué se suspende" />}
  else {<input type="hidden" name="motivo" value="Reactivación administrativa" />}
  <button type="submit" class="btn btn-sm @(activa?"btn-outline":"btn-primary")">@(activa?"Desactivar":"Reactivar")</button>
 </form></td></tr>
}
</tbody></table></div>@if(Model.Count == 0){<div class="empty-mini">No encontramos empresas con ese nombre.</div>}</div>
<p class="ag-hint">La visibilidad pública depende de una mensualidad pagada y vigente. Los cambios de estado quedan registrados en los logs de la aplicación; esta versión no dispone de una auditoría específica en tablas SQL.</p>
