@model Citicio.Models.SolicitudRecuperacionForm
@{ViewData["Title"]="Recuperar contraseña";}
<section class="form-page"><div class="content-head"><span class="eyebrow">SEGURIDAD DE TU CUENTA</span><h1>Recupera tu acceso</h1><p>Si el correo existe, enviaremos un enlace privado de un solo uso, válido por 30 minutos.</p></div>
<div class="form-card"><form asp-action="Recuperar" method="post">
<div asp-validation-summary="All" class="validation"></div><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" type="email" autocomplete="email" required />
<button class="btn btn-primary" type="submit">Enviar enlace de recuperación</button>
</form></div></section>
