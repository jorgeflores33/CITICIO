@model Citicio.Models.RestablecerContrasenaForm
@{ViewData["Title"]="Nueva contraseña";}
<section class="form-page"><div class="content-head"><span class="eyebrow">SEGURIDAD</span><h1>Elige una nueva contraseña</h1><p>El enlace solo se puede usar una vez.</p></div>
<div class="form-card"><form asp-action="Restablecer" method="post">
<div asp-validation-summary="All" class="validation"></div><input type="hidden" asp-for="Token" />
<label asp-for="Contrasena">Contraseña (8+ caracteres, mayúscula, minúscula, número y símbolo)</label><input asp-for="Contrasena" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
<label asp-for="Confirmacion">Confirmar contraseña</label><input asp-for="Confirmacion" type="password" autocomplete="new-password" required />
<button class="btn btn-primary" type="submit">Guardar nueva contraseña</button>
</form></div></section>
