@model HorarioSucursalForm
@{ViewData["Title"]="Horario sucursal";}
<section class="form-page"><div class="content-head"><span class="eyebrow">HORARIOS</span><h1>Agregar horario de sucursal</h1><p>El horario del empleado y las citas deben quedar dentro de estas horas de operación.</p></div><div class="form-card"><form asp-action="HorarioSucursal" method="post"><div asp-validation-summary="All" class="validation"></div>
<label asp-for="SucursalId">Sucursal</label><select asp-for="SucursalId"><option value="0">Selecciona sucursal</option>@foreach(DbRow r in ViewBag.Sucursales){<option value="@r.I("id_sucursal")">@r.S("nombre")</option>}</select>
<label asp-for="Dia">Día de la semana</label><select asp-for="Dia"><option value="1">Lunes</option><option value="2">Martes</option><option value="3">Miércoles</option><option value="4">Jueves</option><option value="5">Viernes</option><option value="6">Sábado</option><option value="7">Domingo</option></select>
<div class="form-grid"><div><label asp-for="Apertura">Apertura</label><input asp-for="Apertura" type="time" /></div><div><label asp-for="Cierre">Cierre</label><input asp-for="Cierre" type="time" /></div></div>
<button type="submit" class="btn btn-primary">Guardar horario →</button></form></div></section>
