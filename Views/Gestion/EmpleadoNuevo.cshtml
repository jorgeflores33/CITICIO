@model EmpleadoForm
@{ViewData["Title"]="Nuevo empleado";}
<section class="form-page"><div class="content-head"><span class="eyebrow">GESTIÓN DEL PERSONAL</span><h1>Registrar personal y acceso</h1><p>El perfil se crea activo. Su cuenta accederá exclusivamente a las funciones permitidas por su rol.</p></div><div class="form-card wide-card"><form asp-action="EmpleadoNuevo" method="post"><div asp-validation-summary="All" class="validation"></div>
<div class="form-grid">@if(User.IsInRole("admin_empresa")){<input asp-for="EmpresaId" type="hidden" />}else{<div><label asp-for="EmpresaId">Empresa</label><select asp-for="EmpresaId"><option value="0">Seleccionar</option>@foreach(DbRow x in ViewBag.Empresas){<option value="@x.I("id_empresa")">@x.S("nombre")</option>}</select></div>}
<div><label asp-for="SucursalId">Sucursal principal</label><select asp-for="SucursalId"><option value="">Sin asignar</option>@foreach(DbRow x in ViewBag.Sucursales){<option value="@x.I("id_sucursal")">@x.S("nombre")</option>}</select></div>
<div><label asp-for="Nombre">Nombre(s)</label><input asp-for="Nombre" /></div><div><label asp-for="Paterno">Apellido paterno</label><input asp-for="Paterno" /></div>
<div><label asp-for="Materno">Apellido materno</label><input asp-for="Materno" /></div><div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" /></div>
<div><label asp-for="Correo">Correo de acceso</label><input asp-for="Correo" type="email" /></div><div><label asp-for="Rol">Rol</label><select asp-for="Rol"><option value="empleado">Empleado</option><option value="encargado_sucursal">Encargado de sucursal</option>@if(User.IsInRole("admin_citicio")){<option value="admin_empresa">Administrador de empresa</option>}</select></div>
<div><label asp-for="ContrasenaTemporal">Contraseña inicial (8+ caracteres, mayúscula, minúscula, número y símbolo)</label><input asp-for="ContrasenaTemporal" type="password" minlength="8" maxlength="128" /></div>
</div><div class="alert alert-info">Entrega la contraseña inicial de forma privada. No la compartas en capturas ni archivos públicos.</div><button class="btn btn-primary" type="submit">Crear empleado con acceso →</button></form></div></section>
